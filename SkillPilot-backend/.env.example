NODE_ENV=development
PORT=5001

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=skillpilot

# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# ==========================
# data.go.kr (공공데이터포털)
# ==========================
# https://www.data.go.kr 에서 발급받은 인코딩된 서비스 키를 그대로 넣으세요.
# 활용신청은 API 마다 별도로 진행되므로 7개 키를 각각 발급받을 수 있습니다.
# 같은 키 하나를 여러 API 에 사용해도 되며, 그 경우 DATA_GO_KR_API_KEY(기본 폴백) 만 채우면 됩니다.

# 기본(폴백) 키 — 개별 키가 비어있을 때 사용
DATA_GO_KR_API_KEY=

# 1. 15003024 — 한국산업인력공단_국가자격 종목 목록 정보
#    전체 자격 종목 목록 스캔 (IT 필터 진입점)
#    https://www.data.go.kr/data/15003024/openapi.do
DATA_GO_KR_KEY_15003024=

# 2. 15041600 — 한국산업인력공단_국가기술자격 종목 정보
#    종목별 상세 (개요·수행직무·진로·출제경향)
#    https://www.data.go.kr/data/15041600/openapi.do
DATA_GO_KR_KEY_15041600=

# 3. 15074408 — 한국산업인력공단_국가자격 시험일정 조회 서비스
#    필기/실기 시험일정, 원서접수 기간, 합격자 발표일
#    https://www.data.go.kr/data/15074408/openapi.do
DATA_GO_KR_KEY_15074408=

# 4. 15003029 — 한국산업인력공단_국가기술자격 종목별 시험정보
#    기술사 등급 시험 시행일정 / 원서접수 정보
#    https://www.data.go.kr/data/15003029/openapi.do
DATA_GO_KR_KEY_15003029=

# 5. 15003027 — 한국산업인력공단_국가전문자격 시험 시행일정 정보
#    국가전문자격(법무사·공인중개사 등) 회차별 시험 일정
#    https://www.data.go.kr/data/15003027/openapi.do
DATA_GO_KR_KEY_15003027=

# 6. 15039800 — 한국산업인력공단_국가기술자격 취득 관련 현황
#    연도/종목별 취득자 수, 교부/미교부 통계 → 인기도 산출
#    https://www.data.go.kr/data/15039800/openapi.do
DATA_GO_KR_KEY_15039800=

# 7. 15075141 — 한국산업인력공단_국가자격 공개문제 조회 서비스
#    실제 기출(공개) 문제 메타데이터 → 문제은행 실데이터 소스
#    https://www.data.go.kr/data/15075141/openapi.do
DATA_GO_KR_KEY_15075141=

# HTTP 타임아웃 (밀리초)
DATA_GO_KR_TIMEOUT_MS=15000

# 스케줄러
SCHEDULER_ENABLED=true
CRON_CERT_SYNC=0 4 * * *
CRON_EXAM_SYNC=0 5 * * 1

# 관리자 API (data.go.kr 동기화, 문제 생성 등)
ADMIN_API_KEY= 

# CORS
CORS_ORIGIN=http://localhost:5173
