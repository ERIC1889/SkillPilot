NODE_ENV=development
PORT=5000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=skillpilot

# MongoDB
MONGODB_URI=mongodb://localhost:27017/skillpilot

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# data.go.kr (공공데이터포털)
# https://www.data.go.kr 에서 발급받은 인코딩된 서비스 키를 그대로 넣으세요.
DATA_GO_KR_API_KEY=
DATA_GO_KR_TIMEOUT_MS=15000

# 스케줄러
SCHEDULER_ENABLED=true
CRON_CERT_SYNC=0 4 * * *
CRON_EXAM_SYNC=0 5 * * 1

# 관리자 API (data.go.kr 동기화, 문제 생성 등)
ADMIN_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173
